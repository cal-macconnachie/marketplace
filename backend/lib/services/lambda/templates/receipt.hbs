<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>Receipt</title>
    <style>
      html, body { margin: 0 !important; padding: 0 !important; height: 100% !important; width: 100% !important; }
      * { -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; }
      div[style*="margin: 16px 0"] { margin: 0 !important; }
      table, td { mso-table-lspace: 0pt !important; mso-table-rspace: 0pt !important; }
      table { border-collapse: collapse !important; }
      img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
      a { text-decoration: none; color: inherit; }

      /* Container */
      .wrapper { width: 100%; background: #f6f7fb; }
      .container { width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff; }
      .px-24 { padding-left: 24px; padding-right: 24px; }
      .py-16 { padding-top: 16px; padding-bottom: 16px; }
      .py-24 { padding-top: 24px; padding-bottom: 24px; }
      .pt-8 { padding-top: 8px; }
      .pb-8 { padding-bottom: 8px; }
      .pb-16 { padding-bottom: 16px; }

      .muted { color: #6b7280; font-size: 12px; line-height: 18px; }
      .small { font-size: 12px; }
      .text-right { text-align: right; }
      .text-center { text-align: center; }
      .hr { height: 1px; line-height: 1px; background: #e5e7eb; border: none; margin: 0; }

      .brand { font: 600 18px/1.2 system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #111827; text-align: center; }
      .h1 { font: 700 20px/1.3 system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #111827; margin: 0; }
      .body { font: 400 14px/20px system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #111827; }

      .table { width: 100%; border-collapse: collapse; }
      .table th { text-align: left; font: 600 12px/16px system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #6b7280; padding: 8px 0; border-bottom: 1px solid #e5e7eb; }
      .table td { vertical-align: top; padding: 12px 0; border-bottom: 1px solid #f3f4f6; font: 400 14px/20px system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #111827; }
      .table .qty, .table .price, .table .amount { text-align: right; white-space: nowrap; }
      .totals td { padding: 6px 0; }
      .totals .label { color: #6b7280; }
      .totals .value { text-align: right; }
      .totals .grand { font-weight: 700; color: #111827; border-top: 2px solid #e5e7eb; padding-top: 10px; }

      .badge { display: inline-block; font-size: 11px; color: #374151; background: #f3f4f6; border-radius: 999px; padding: 2px 8px; margin-left: 6px; }

      /* Responsive helpers */
      .mobile-only { display: none; }
      .mobile-hidden { display: table-cell; }
      .address-line { display: block; }

      @media (prefers-color-scheme: dark) {
        .wrapper { background: #0b0f15 !important; }
        .container { background: #111827 !important; }
        .brand, .h1, .body, .table td { color: #f9fafb !important; }
        .muted, .table th, .totals .label { color: #9ca3af !important; }
        .hr { background: #374151 !important; }
        .table td { border-bottom-color: #1f2937 !important; }
        .badge { background: #1f2937 !important; color: #e5e7eb !important; }
        .totals .grand { border-top-color: #374151 !important; }
      }
      @media screen and (max-width: 600px) {
        .px-24 { padding-left: 16px !important; padding-right: 16px !important; }
        /* Stack two-column sections on mobile */
        .stack-on-mobile { display: block !important; width: 100% !important; }
        .stack-on-mobile td, .stack-on-mobile th { display: block !important; width: 100% !important; text-align: left !important; }
        .text-right { text-align: left !important; }
        /* Items table: hide Qty & Price; show inline meta */
        .items-table .qty,
        .items-table .price { display: none !important; }
        .mobile-only { display: block !important; }
        .mobile-hidden { display: none !important; }
      }
    </style>
  </head>
  <body class="body" style="background:#f6f7fb;">
    <!-- Preheader (hidden preview text) -->
    <div style="display:none;visibility:hidden;opacity:0;overflow:hidden;height:0;width:0;font-size:1px;line-height:1px;color:#fff;">
      {{preheader}}
    </div>

    <table role="presentation" class="wrapper" cellpadding="0" cellspacing="0" width="100%" style="width:100%;background:#f6f7fb;">
      <tr>
        <td align="center">
          <table role="presentation" class="container" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;background:#ffffff;">
            <!-- Header -->
            <tr>
              <td class="px-24 py-16">
                <table width="100%" role="presentation">
                  <tr>
                    <td class="brand" align="center">
                      {{#if organization_logo_url}}
                        <img src="{{organization_logo_url}}" alt="{{header_brand}}" height="32" style="max-height:32px;vertical-align:middle;display:block;margin:0 auto;">
                      {{else}}
                        {{header_brand}}
                      {{/if}}
                    </td>
                  </tr>
                  {{#if receipt_number}}
                  <tr>
                    <td class="text-right muted small">
                      Receipt #{{receipt_number}}
                    </td>
                  </tr>
                  {{/if}}
                </table>
              </td>
            </tr>

            <tr><td><hr class="hr" /></td></tr>

            <!-- Hero / Greeting -->
            <tr>
              <td class="px-24 py-24">
                <h1 class="h1">Thank you for your purchase{{#if customer_name}}, {{customer_name}}{{/if}}!</h1>
              </td>
            </tr>

            <!-- Line Items -->
            {{#if is_multi_seller}}
              {{#each seller_groups}}
                <tr>
                  <td class="px-24 pt-8 pb-8">
                    <div class="small" style="font-weight:600;">Seller: {{this.seller_name}}{{#unless this.seller_name}}{{this.seller_id}}{{/unless}}</div>
                  </td>
                </tr>
                <tr>
                  <td class="px-24">
                    <table role="presentation" class="table items-table">
                      <thead>
                        <tr>
                          <th align="left">Item</th>
                          <th class="qty" align="right">Qty</th>
                          <th class="price" align="right">Price</th>
                          <th class="amount" align="right">Amount</th>
                        </tr>
                      </thead>
                      <tbody>
                        {{#each this.items}}
                          <tr>
                            <td>
                              <div style="font-weight:600;">{{this.product_name}}</div>
                              {{#if this.product_description}}
                                <div class="muted small" style="margin-top:2px;">{{this.product_description}}</div>
                              {{/if}}
                              <div class="muted small" style="margin-top:4px;">
                                {{#if this.product_id}}<span>ID: {{this.product_id}}</span>{{/if}}
                                {{#if this.is_subscription}}
                                  <span class="badge">Subscription{{#if this.interval_text}} • {{this.interval_text}}{{/if}}</span>
                                {{/if}}
                              </div>
                              <div class="mobile-only muted small" style="margin-top:6px;">
                                {{#if this.quantity}}Qty {{this.quantity}}{{/if}}{{#if this.unit_price_formatted}}{{#if this.quantity}} • {{/if}}{{this.unit_price_formatted}}{{/if}}
                              </div>
                            </td>
                            <td class="qty mobile-hidden" align="right">{{this.quantity}}</td>
                            <td class="price mobile-hidden" align="right">{{this.unit_price_formatted}}</td>
                            <td class="amount" align="right">{{this.subtotal_formatted}}</td>
                          </tr>
                        {{/each}}
                      </tbody>
                    </table>
                  </td>
                </tr>
                <!-- Seller totals -->
                <tr>
                  <td class="px-24 py-16">
                    <table role="presentation" class="table totals">
                      <tbody>
                        <tr>
                          <td class="label">Subtotal</td>
                          <td class="value" align="right">{{subtotal_formatted}}</td>
                        </tr>
                        {{#if fees_formatted}}
                        <tr>
                          <td class="label">Fees</td>
                          <td class="value" align="right">{{fees_formatted}}</td>
                        </tr>
                        {{/if}}
                        {{#if tax_formatted}}
                        <tr>
                          <td class="label">Tax</td>
                          <td class="value" align="right">{{tax_formatted}}</td>
                        </tr>
                        {{/if}}
                        <tr>
                          <td class="label grand">Total</td>
                          <td class="value grand" align="right">{{total_formatted}}</td>
                        </tr>
                      </tbody>
                    </table>
                    <div class="muted small" style="margin-top:6px;">
                      {{#if statement_descriptor}}<div>Descriptor: {{statement_descriptor}}</div>{{/if}}
                      {{#if support_url}}<div>Support: <a href="{{support_url}}" style="color:#4f46e5;">Contact</a></div>{{/if}}
                    </div>
                  </td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td class="px-24">
                  <table role="presentation" class="table items-table">
                    <thead>
                      <tr>
                        <th align="left">Item</th>
                        <th class="qty" align="right">Qty</th>
                        <th class="price" align="right">Price</th>
                        <th class="amount" align="right">Amount</th>
                      </tr>
                    </thead>
                    <tbody>
                      {{#each line_items}}
                        <tr>
                          <td>
                            <div style="font-weight:600;">{{this.product_name}}</div>
                            {{#if this.product_description}}
                              <div class="muted small" style="margin-top:2px;">{{this.product_description}}</div>
                            {{/if}}
                            <div class="muted small" style="margin-top:4px;">
                              {{#if this.is_subscription}}
                                <span class="badge">Subscription{{#if this.interval_text}} • {{this.interval_text}}{{/if}}</span>
                              {{/if}}
                              {{#if this.seller_name}}<span class="badge">Seller: {{this.seller_name}}</span>{{/if}}
                            </div>
                            <div class="mobile-only muted small" style="margin-top:6px;">
                              {{#if this.quantity}}Qty {{this.quantity}}{{/if}}{{#if this.unit_price_formatted}}{{#if this.quantity}} • {{/if}}{{this.unit_price_formatted}}{{/if}}
                            </div>
                          </td>
                          <td class="qty mobile-hidden" align="right">{{this.quantity}}</td>
                          <td class="price mobile-hidden" align="right">{{this.unit_price_formatted}}</td>
                          <td class="amount" align="right">{{this.subtotal_formatted}}</td>
                        </tr>
                      {{/each}}
                    </tbody>
                  </table>
                </td>
              </tr>
            {{/if}}

            <!-- Totals -->
            <tr>
              <td class="px-24 py-16">
                <table role="presentation" class="table totals">
                  <tbody>
                    <tr>
                      <td class="label">Subtotal</td>
                      <td class="value" align="right">{{summary.subtotal_formatted}}</td>
                    </tr>
                    {{#if summary.discounts_formatted}}
                    <tr>
                      <td class="label">Discounts</td>
                      <td class="value" align="right">-{{summary.discounts_formatted}}</td>
                    </tr>
                    {{/if}}
                    {{#if summary.tax_formatted}}
                    <tr>
                      <td class="label">Tax</td>
                      <td class="value" align="right">{{summary.tax_formatted}}</td>
                    </tr>
                    {{/if}}
                    <tr>
                      <td class="label grand">Total</td>
                      <td class="value grand" align="right">{{summary.total_formatted}}</td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>

            <!-- Payment Method -->
            <tr>
              <td class="px-24 pb-16">
                <table role="presentation" width="100%" class="stack-on-mobile">
                  <tr>
                    <td class="muted small">
                      {{#if payment_method_brand}}Paid with {{payment_method_brand}}{{/if}}{{#if payment_method_last4}} •••• {{payment_method_last4}}{{/if}}
                      {{#if payment_method_expiry_month}} (exp {{payment_method_expiry_month}}/{{payment_method_expiry_year}}){{/if}}
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr><td><hr class="hr" /></td></tr>

            <!-- Customer & Org Details -->
            <tr>
              <td class="px-24 py-16">
                <table role="presentation" width="100%" class="stack-on-mobile">
                  <tr>
                    <td valign="top" width="50%">
                      <div class="small" style="font-weight:600;">Billed To</div>
                      <div class="small" style="margin-top:4px;">{{customer_name}}</div>
                      {{#if customer_email}}<div class="small muted">{{customer_email}}</div>{{/if}}
                    </td>
                    <td valign="top" width="50%" class="text-right">
                      {{#if is_multi_seller}}
                        <div class="small" style="font-weight:600;">Sellers</div>
                        {{#each sellers}}
                          <div class="small" style="margin-top:8px;">{{this.name}}</div>
                          {{#if this.email}}<div class="small muted">{{this.email}}</div>{{/if}}
                          {{#if this.address_line_1}}
                            <div class="small muted" style="margin-top:2px;">
                              <span class="address-line">{{this.address_line_1}}</span>
                              {{#if this.address_line_2}}<span class="address-line">{{this.address_line_2}}</span>{{/if}}
                              <span class="address-line">{{this.city}}, {{this.state}} {{this.postal_code}}</span>
                              <span class="address-line">{{this.country}}</span>
                            </div>
                          {{/if}}
                        {{/each}}
                      {{else}}
                        <div class="small" style="font-weight:600;">Seller</div>
                        <div class="small" style="margin-top:4px;">{{organization_name}}</div>
                        {{#if organization_email}}<div class="small muted">{{organization_email}}</div>{{/if}}
                        {{#if organization_address_line_1}}
                          <div class="small muted" style="margin-top:4px;">
                            <span class="address-line">{{organization_address_line_1}}</span>
                            {{#if organization_address_line_2}}<span class="address-line">{{organization_address_line_2}}</span>{{/if}}
                            <span class="address-line">{{organization_city}}, {{organization_state}} {{organization_postal_code}}</span>
                            <span class="address-line">{{organization_country}}</span>
                          </div>
                        {{/if}}
                      {{/if}}
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            {{#if notes}}
            <tr>
              <td class="px-24 pb-16">
                <div class="small">{{notes}}</div>
              </td>
            </tr>
            {{/if}}

            <!-- Footer -->
            <tr>
              <td class="px-24 py-16 text-center muted small">
                {{#if receipt_url}}
                  <div style="margin-bottom:8px;">
                    <a href="{{receipt_url}}" style="color:#4f46e5;">View receipt online</a>
                  </div>
                {{/if}}
                {{#if support_url}}
                  Need help? Visit <a href="{{support_url}}" style="color:#4f46e5;">Support</a>.
                {{/if}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
  </html>
