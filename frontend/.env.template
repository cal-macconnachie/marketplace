# Google Places API Configuration
# Get your API key from: https://developers.google.com/maps/documentation/places/web-service/get-api-key
# Enable the following APIs:
# - Places API
# - Geocoding API  
# - Maps JavaScript API
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Stripe Configuration
# Get your publishable key from: https://dashboard.stripe.com/apikeys
# Use test keys for development (pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# API Environment
VITE_API_ENV=dev

# AWS Cognito Configuration
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_*******
VITE_COGNITO_CLIENT_ID=*****************************