{
  "name": "marketplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "types",
    "constants"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "backend:install": "yarn workspace marketplace-backend install",
    "backend:build": "yarn workspace marketplace-backend build",
    "backend:test": "yarn workspace marketplace-backend test",
    "backend:lint": "yarn workspace marketplace-backend lint",
    "backend:cdk": "yarn workspace marketplace-backend cdk",
    "frontend:install": "yarn workspace marketplace-frontend install",
    "frontend:dev": "yarn workspace marketplace-frontend dev",
    "frontend:build": "yarn workspace marketplace-frontend build",
    "frontend:preview": "yarn workspace marketplace-frontend preview",
    "frontend:lint": "yarn workspace marketplace-frontend lint",
    "install:all": "yarn install",
    "build:all": "yarn backend:build && yarn frontend:build",
    "lint:all": "yarn backend:lint && yarn frontend:lint"
  },
  "packageManager": "yarn@4.10.3"
}
