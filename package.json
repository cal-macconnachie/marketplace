{
  "name": "payment-auth-backend",
  "version": "0.1.0",
  "bin": {
    "payment-auth-backend": "bin/payment-auth-backend.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "lint": "eslint \"lib/**/*.ts\"",
    "product-manager": "ENV_FILE=.env.local nodemon --watch lib/**/*.ts --watch product-server.ts --exec 'ts-node --transpile-only product-server.ts'",
    "product-manager-production": "ENV_FILE=.env.local.production nodemon --watch lib/**/*.ts --watch product-server.ts --exec 'ts-node --transpile-only product-server.ts'",
    "clean": "find ./bin ./lib ./test -type f \\( -name '*.js' -o -name '*.d.ts' \\) -delete"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "22.7.9",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "aws-cdk": "2.1018.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "eslint": "^9.28.0",
    "eslint-plugin-jest": "^28.13.3",
    "eslint-plugin-prettier": "^5.4.1",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.865.0",
